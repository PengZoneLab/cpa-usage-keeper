+package auth
+
+import (
+	"context"
+	"errors"
+	"sync"
+
+	executor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+var ErrResetGuardEnabled = errors.New("reset guard requires a disabled codex account")
+var ErrResetGuardClosed = errors.New("account execution admission is closed")
+
+type resetExecutionGate struct {
+	blocked bool
+	next    uint64
+	active  map[uint64]context.CancelFunc
+	changed chan struct{}
+}
+
+func (m *Manager) resetGateLocked(id string) *resetExecutionGate {
+	if m.resetGates == nil {
+		m.resetGates = make(map[string]*resetExecutionGate)
+	}
+	g := m.resetGates[id]
+	if g == nil {
+		g = &resetExecutionGate{active: make(map[uint64]context.CancelFunc), changed: make(chan struct{})}
+		m.resetGates[id] = g
+	}
+	return g
+}
+
+// beginResetExecution checks the live account, not a potentially stale selection.
+// Admission and stop share the same lock order. Cancellation alone never releases
+// an execution: the executor (or its source stream) must actually exit first.
+func (m *Manager) beginResetExecution(ctx context.Context, auth *Auth, exec ProviderExecutor) (context.Context, func(), error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if auth == nil || auth.Provider != "codex" {
+		return ctx, func() {}, nil
+	}
+	m.mu.RLock()
+	live := m.auths[auth.ID]
+	if live == nil {
+		live = auth
+	}
+	m.resetGuardMu.Lock()
+	g := m.resetGateLocked(auth.ID)
+	if live.Disabled || g.blocked {
+		m.resetGuardMu.Unlock()
+		m.mu.RUnlock()
+		return nil, nil, ErrResetGuardClosed
+	}
+	child, cancel := context.WithCancel(ctx)
+	g.next++
+	token := g.next
+	g.active[token] = cancel
+	m.resetGuardMu.Unlock()
+	m.mu.RUnlock()
+	var once sync.Once
+	finish := func() {
+		once.Do(func() {
+			cancel()
+			// A websocket handshake may finish after the initial stop close. Keep this
+			// execution counted until its late session has also been closed.
+			m.resetGuardMu.Lock()
+			blocked := g.blocked
+			m.resetGuardMu.Unlock()
+			if blocked {
+				if closer, ok := exec.(AuthExecutionSessionCloser); ok {
+					closer.CloseAuthExecutionSessions(auth.ID)
+				}
+			}
+			m.resetGuardMu.Lock()
+			delete(g.active, token)
+			close(g.changed)
+			g.changed = make(chan struct{})
+			m.resetGuardMu.Unlock()
+		})
+	}
+	return child, finish, nil
+}
+
+func (m *Manager) guardedExecute(ctx context.Context, exec ProviderExecutor, auth *Auth, req executor.Request, opts executor.Options, count bool) (executor.Response, error) {
+	child, finish, err := m.beginResetExecution(ctx, auth, exec)
+	if err != nil {
+		return executor.Response{}, err
+	}
+	defer finish()
+	if count {
+		return exec.CountTokens(child, auth, req, opts)
+	}
+	return exec.Execute(child, auth, req, opts)
+}
+
+func (m *Manager) guardedExecuteStream(ctx context.Context, exec ProviderExecutor, auth *Auth, req executor.Request, opts executor.Options) (*executor.StreamResult, error) {
+	if auth == nil || auth.Provider != "codex" {
+		return exec.ExecuteStream(ctx, auth, req, opts)
+	}
+	child, finish, err := m.beginResetExecution(ctx, auth, exec)
+	if err != nil {
+		return nil, err
+	}
+	result, err := exec.ExecuteStream(child, auth, req, opts)
+	if err != nil || result == nil || result.Chunks == nil {
+		finish()
+		return result, err
+	}
+	chunks := make(chan executor.StreamChunk)
+	go func() {
+		defer close(chunks)
+		defer finish()
+		// Do not return on cancellation: drain until the source closes, otherwise
+		// active=0 would be an invented receipt for a still-running upstream worker.
+		for chunk := range result.Chunks {
+			select {
+			case chunks <- chunk:
+			case <-child.Done():
+			}
+		}
+	}()
+	return &executor.StreamResult{Headers: result.Headers, Chunks: chunks}, nil
+}
+
+// StopAndCancel closes generation admission and waits for actual executor exit.
+// Management APICall is deliberately outside this gate so reset-credit inventory
+// and redemption remain available on a disabled account.
+func (m *Manager) StopAndCancel(ctx context.Context, id string) (int, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	m.mu.RLock()
+	auth := m.auths[id]
+	if auth == nil || auth.Provider != "codex" || !auth.Disabled {
+		m.mu.RUnlock()
+		return 0, ErrResetGuardEnabled
+	}
+	exec := m.executors[executorKeyFromAuth(auth)]
+	m.resetGuardMu.Lock()
+	g := m.resetGateLocked(id)
+	g.blocked = true
+	for _, cancel := range g.active {
+		cancel()
+	}
+	m.resetGuardMu.Unlock()
+	m.mu.RUnlock()
+	// Close idle sessions too. Bound waiting, not the upstream worker lifetime.
+	closed := make(chan struct{})
+	go func() {
+		defer close(closed)
+		if closer, ok := exec.(AuthExecutionSessionCloser); ok {
+			closer.CloseAuthExecutionSessions(id)
+		}
+	}()
+	select {
+	case <-closed:
+	case <-ctx.Done():
+		return m.resetActive(id), ctx.Err()
+	}
+	for {
+		m.resetGuardMu.Lock()
+		active, changed := len(g.active), g.changed
+		m.resetGuardMu.Unlock()
+		if active == 0 {
+			if err := ctx.Err(); err != nil {
+				return 0, err
+			}
+			m.mu.RLock()
+			current := m.auths[id]
+			disabled := current != nil && current.Disabled
+			m.mu.RUnlock()
+			if !disabled {
+				return 0, ErrResetGuardEnabled
+			}
+			return 0, nil
+		}
+		select {
+		case <-changed:
+		case <-ctx.Done():
+			return m.resetActive(id), ctx.Err()
+		}
+	}
+}
+
+func (m *Manager) resetActive(id string) int {
+	m.resetGuardMu.Lock()
+	defer m.resetGuardMu.Unlock()
+	return len(m.resetGateLocked(id).active)
+}
+
+// ReopenResetExecutionAdmission is called only after an explicit management
+// enable succeeds. Background auth refresh must not silently remove a stop latch.
+func (m *Manager) ReopenResetExecutionAdmission(id string) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	auth := m.auths[id]
+	if auth == nil || auth.Disabled {
+		return
+	}
+	m.resetGuardMu.Lock()
+	defer m.resetGuardMu.Unlock()
+	m.resetGateLocked(id).blocked = false
+}
