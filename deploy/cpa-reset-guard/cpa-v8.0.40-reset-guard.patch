+package management
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// StopAndCancel returns a drain receipt only after all generation workers exit.
+func (h *Handler) StopAndCancel(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "auth manager unavailable", "drained": false})
+		return
+	}
+	var req struct {
+		AuthIndex string `json:"auth_index"`
+	}
+	if c.ShouldBindJSON(&req) != nil || strings.TrimSpace(req.AuthIndex) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "auth_index is required", "drained": false})
+		return
+	}
+	auth := h.authByIndex(strings.TrimSpace(req.AuthIndex))
+	if auth == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "auth not found", "drained": false})
+		return
+	}
+	// This deadline bounds the management acknowledgment only, never inference.
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 20*time.Second)
+	defer cancel()
+	active, err := h.authManager.StopAndCancel(ctx, auth.ID)
+	if err != nil {
+		status := http.StatusGatewayTimeout
+		if errors.Is(err, coreauth.ErrResetGuardEnabled) {
+			status = http.StatusConflict
+		}
+		c.JSON(status, gin.H{"auth_index": req.AuthIndex, "active": active, "drained": false, "error": err.Error()})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"auth_index": req.AuthIndex, "disabled": true, "active": 0, "drained": true})
+}
