+package executor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	auth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// Exercise the real production auto executor through Manager, not just gate counters.
+func TestCodexResetGuardActualTransports(t *testing.T) {
+	for _, mode := range []string{"http-sync", "http-stream", "websocket-stream"} {
+		t.Run(mode, func(t *testing.T) {
+			started, disconnected := make(chan struct{}), make(chan struct{})
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if mode == "websocket-stream" {
+					c, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					defer c.Close()
+					if _, _, err = c.ReadMessage(); err != nil {
+						t.Error(err)
+						return
+					}
+					_ = c.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"r-reset"}}`))
+					close(started)
+					_, _, _ = c.ReadMessage()
+					close(disconnected)
+				} else {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = w.Write([]byte("data: {\"type\":\"response.created\",\"response\":{\"id\":\"r-reset\"}}\n\n"))
+					w.(http.Flusher).Flush()
+					close(started)
+					<-r.Context().Done()
+					close(disconnected)
+				}
+			}))
+			defer upstream.Close()
+			cfg := &config.Config{}
+			manager := auth.NewManager(nil, nil, nil)
+			manager.SetConfig(cfg)
+			manager.SetRetryConfig(0, 0, 0)
+			manager.RegisterExecutor(NewCodexAutoExecutor(cfg))
+			id, model := "reset-guard-"+mode, "gpt-5-reset-"+mode
+			current, err := manager.Register(context.Background(), &auth.Auth{ID: id, Provider: "codex", Status: auth.StatusActive, Attributes: map[string]string{"api_key": "test-key", "base_url": upstream.URL, "websockets": "true"}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: model}})
+			defer registry.GetGlobalRegistry().UnregisterClient(id)
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			if mode == "websocket-stream" {
+				ctx = core.WithDownstreamWebsocket(ctx)
+			}
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				req := core.Request{Model: model, Payload: []byte(`{"model":"` + model + `","input":[]}`)}
+				opts := core.Options{SourceFormat: translator.FromString("codex"), Metadata: map[string]any{core.ExecutionSessionMetadataKey: id}}
+				if mode == "http-sync" {
+					_, _ = manager.Execute(ctx, []string{"codex"}, req, opts)
+				} else {
+					stream, err := manager.ExecuteStream(ctx, []string{"codex"}, req, opts)
+					if err == nil && stream != nil {
+						for range stream.Chunks {
+						}
+					}
+				}
+			}()
+			select {
+			case <-started:
+			case <-ctx.Done():
+				t.Fatal("generation did not start")
+			}
+			_, committed, err := manager.Modify(context.Background(), id, current.RegistrationEpoch, func(a *auth.Auth) error { a.Disabled = true; return nil })
+			if err != nil || !committed {
+				t.Fatalf("disable: %v committed=%v", err, committed)
+			}
+			if n, err := manager.StopAndCancel(ctx, id); err != nil || n != 0 {
+				t.Fatalf("drain active=%d err=%v", n, err)
+			}
+			select {
+			case <-done:
+			case <-ctx.Done():
+				t.Fatal("generation has not exited")
+			}
+			select {
+			case <-disconnected:
+			case <-ctx.Done():
+				t.Fatal("upstream still connected")
+			}
+			// Disabled accounts must retain their identity for management reset calls.
+			live, ok := manager.GetByID(id)
+			if !ok || !live.Disabled {
+				t.Fatal("account deleted or reenabled")
+			}
+		})
+	}
+}
