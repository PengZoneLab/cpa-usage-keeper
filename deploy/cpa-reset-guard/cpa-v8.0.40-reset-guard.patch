+package auth
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	executor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type resetNetworkExecutor struct {
+	url      string
+	started  chan string
+	exited   chan string
+	mu       sync.Mutex
+	sessions map[string]*websocket.Conn
+	closes   map[string]int
+	stubborn chan struct{}
+	late     chan struct{}
+}
+
+func (e *resetNetworkExecutor) Identifier() string                                { return "codex" }
+func (e *resetNetworkExecutor) Refresh(_ context.Context, a *Auth) (*Auth, error) { return a, nil }
+func (e *resetNetworkExecutor) HttpRequest(ctx context.Context, a *Auth, r *http.Request) (*http.Response, error) {
+	return http.DefaultClient.Do(r.WithContext(ctx))
+}
+func (e *resetNetworkExecutor) Execute(ctx context.Context, a *Auth, _ executor.Request, _ executor.Options) (executor.Response, error) {
+	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, e.url+"/"+a.ID, nil)
+	resp, err := http.DefaultClient.Do(req)
+	if resp != nil {
+		defer resp.Body.Close()
+		_, err = io.Copy(io.Discard, resp.Body)
+	}
+	e.exited <- a.ID
+	return executor.Response{}, err
+}
+func (e *resetNetworkExecutor) CountTokens(ctx context.Context, a *Auth, r executor.Request, o executor.Options) (executor.Response, error) {
+	return e.Execute(ctx, a, r, o)
+}
+func (e *resetNetworkExecutor) ExecuteStream(ctx context.Context, a *Auth, _ executor.Request, _ executor.Options) (*executor.StreamResult, error) {
+	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, e.url+"/"+a.ID, nil)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	ch := make(chan executor.StreamChunk)
+	go func() {
+		defer close(ch)
+		defer resp.Body.Close()
+		_, _ = io.Copy(io.Discard, resp.Body)
+		if e.stubborn != nil {
+			<-e.stubborn
+		}
+		if e.late != nil {
+			<-e.late
+			e.mu.Lock()
+			e.closes[a.ID] = -100
+			e.mu.Unlock()
+		}
+		e.exited <- a.ID
+	}()
+	return &executor.StreamResult{Chunks: ch}, nil
+}
+func (e *resetNetworkExecutor) CloseAuthExecutionSessions(id string) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if e.sessions[id] != nil {
+		_ = e.sessions[id].Close()
+		delete(e.sessions, id)
+	}
+	e.closes[id]++
+}
+func setupResetNetwork(t *testing.T) (*Manager, *resetNetworkExecutor, *Auth, *Auth) {
+	t.Helper()
+	e := &resetNetworkExecutor{started: make(chan string, 20), exited: make(chan string, 20), closes: make(map[string]int), sessions: make(map[string]*websocket.Conn)}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(200)
+		w.(http.Flusher).Flush()
+		e.started <- r.URL.Path[1:]
+		<-r.Context().Done()
+	}))
+	e.url = server.URL
+	t.Cleanup(server.Close)
+	m := NewManager(nil, nil, nil)
+	m.RegisterExecutor(e)
+	a, b := &Auth{ID: "a", Provider: "codex"}, &Auth{ID: "b", Provider: "codex"}
+	m.auths[a.ID] = a.Clone()
+	m.auths[b.ID] = b.Clone()
+	return m, e, a, b
+}
+func disableReset(m *Manager, id string) { m.mu.Lock(); m.auths[id].Disabled = true; m.mu.Unlock() }
+func waitReset(t *testing.T, ch <-chan string, want string) {
+	t.Helper()
+	select {
+	case got := <-ch:
+		if got != want {
+			t.Fatalf("got %s want %s", got, want)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("worker did not acknowledge")
+	}
+}
+func drainReset(t *testing.T, m *Manager, id string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if n, err := m.StopAndCancel(ctx, id); err != nil || n != 0 {
+		t.Fatalf("drain active=%d err=%v", n, err)
+	}
+}
+func TestResetGuardNetworkSyncAndIsolation(t *testing.T) {
+	m, e, a, b := setupResetNetwork(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go func() { _, _ = m.guardedExecute(ctx, e, a, executor.Request{}, executor.Options{}, false) }()
+	waitReset(t, e.started, "a")
+	go func() { _, _ = m.guardedExecute(ctx, e, b, executor.Request{}, executor.Options{}, true) }()
+	waitReset(t, e.started, "b")
+	disableReset(m, a.ID)
+	drainReset(t, m, a.ID)
+	waitReset(t, e.exited, "a")
+	if m.resetActive(b.ID) != 1 {
+		t.Fatal("other account canceled")
+	}
+	if _, err := m.guardedExecute(ctx, e, a, executor.Request{}, executor.Options{}, false); !errors.Is(err, ErrResetGuardClosed) {
+		t.Fatalf("late admission: %v", err)
+	}
+	cancel()
+	waitReset(t, e.exited, "b")
+}
+func TestResetGuardNetworkStreamCancellation(t *testing.T) {
+	m, e, a, _ := setupResetNetwork(t)
+	result, err := m.guardedExecuteStream(context.Background(), e, a, executor.Request{}, executor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitReset(t, e.started, "a")
+	disableReset(m, a.ID)
+	drainReset(t, m, a.ID)
+	waitReset(t, e.exited, "a")
+	if _, open := <-result.Chunks; open {
+		t.Fatal("source still open")
+	}
+}
+func TestResetGuardSourceMustExitAndLateSessionClosed(t *testing.T) {
+	m, e, a, _ := setupResetNetwork(t)
+	e.stubborn = make(chan struct{})
+	e.late = make(chan struct{})
+	result, err := m.guardedExecuteStream(context.Background(), e, a, executor.Request{}, executor.Options{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	waitReset(t, e.started, "a")
+	disableReset(m, a.ID)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if n, err := m.StopAndCancel(ctx, a.ID); err == nil || n != 1 {
+		t.Fatalf("fabricated drain active=%d err=%v", n, err)
+	}
+	close(e.stubborn)
+	close(e.late)
+	drainReset(t, m, a.ID)
+	<-result.Chunks
+	e.mu.Lock()
+	closes := e.closes[a.ID]
+	e.mu.Unlock()
+	if closes < -99 {
+		t.Fatal("late session not closed on exit")
+	}
+}
+func TestResetGuardNetworkWebsocketCloseAndExplicitReopen(t *testing.T) {
+	m, e, a, b := setupResetNetwork(t)
+	gone := make(chan string, 2)
+	wsServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer c.Close()
+		_, _, _ = c.ReadMessage()
+		gone <- r.URL.Path[1:]
+	}))
+	defer wsServer.Close()
+	for _, id := range []string{a.ID, b.ID} {
+		c, _, err := websocket.DefaultDialer.Dial("ws"+wsServer.URL[4:]+"/"+id, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		e.sessions[id] = c
+	}
+	defer e.CloseAuthExecutionSessions(b.ID)
+	if _, err := m.StopAndCancel(context.Background(), a.ID); !errors.Is(err, ErrResetGuardEnabled) {
+		t.Fatal("enabled account accepted")
+	}
+	disableReset(m, a.ID)
+	drainReset(t, m, a.ID)
+	waitReset(t, gone, "a")
+	if e.sessions[b.ID] == nil {
+		t.Fatal("other websocket closed")
+	}
+	m.mu.Lock()
+	m.auths[a.ID].Disabled = false
+	m.mu.Unlock()
+	if _, _, err := m.beginResetExecution(context.Background(), a, e); !errors.Is(err, ErrResetGuardClosed) {
+		t.Fatal("background update removed latch")
+	}
+	m.ReopenResetExecutionAdmission(a.ID)
+	_, finish, err := m.beginResetExecution(context.Background(), a, e)
+	if err != nil {
+		t.Fatal(err)
+	}
+	finish()
+}
+
+func TestResetGuardConcurrentLateAdmission(t *testing.T) {
+	m, e, a, _ := setupResetNetwork(t)
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	workers.Add(50)
+	for i := 0; i < 50; i++ {
+		go func() {
+			defer workers.Done()
+			<-start
+			_, finish, err := m.beginResetExecution(context.Background(), a, e)
+			if err == nil {
+				finish()
+			} else if !errors.Is(err, ErrResetGuardClosed) {
+				t.Errorf("unexpected admission error: %v", err)
+			}
+		}()
+	}
+	close(start)
+	disableReset(m, a.ID)
+	drainReset(t, m, a.ID)
+	workers.Wait()
+	if m.resetActive(a.ID) != 0 {
+		t.Fatal("late registrations escaped drain")
+	}
+	for i := 0; i < 10; i++ {
+		if _, _, err := m.beginResetExecution(context.Background(), a, e); !errors.Is(err, ErrResetGuardClosed) {
+			t.Fatal("gate reopened")
+		}
+	}
+}
