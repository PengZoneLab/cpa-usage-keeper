+package management
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestStopAndCancelManagementReceipt(t *testing.T) {
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	for _, tc := range []struct {
+		name, provider string
+		disabled       bool
+		status         int
+	}{{"disabled", "codex", true, 200}, {"enabled", "codex", false, 409}, {"other", "claude", true, 409}} {
+		t.Run(tc.name, func(t *testing.T) {
+			manager := coreauth.NewManager(nil, nil, nil)
+			auth := &coreauth.Auth{ID: "guard-" + tc.name, Provider: tc.provider, Disabled: tc.disabled}
+			index := auth.EnsureIndex()
+			if _, err := manager.Register(context.Background(), auth); err != nil {
+				t.Fatal(err)
+			}
+			h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir()}, manager)
+			rec := httptest.NewRecorder()
+			ctx, _ := gin.CreateTestContext(rec)
+			ctx.Request = httptest.NewRequest(http.MethodPost, "/v8/management/routing/stop-and-cancel", strings.NewReader(`{"auth_index":"`+index+`"}`))
+			h.StopAndCancel(ctx)
+			if rec.Code != tc.status {
+				t.Fatalf("status %d body %s", rec.Code, rec.Body)
+			}
+			var result map[string]any
+			if err := json.Unmarshal(rec.Body.Bytes(), &result); err != nil {
+				t.Fatal(err)
+			}
+			if result["drained"] != (tc.status == 200) {
+				t.Fatalf("invalid receipt: %v", result)
+			}
+			if tc.status == 200 && (result["active"] != float64(0) || result["disabled"] != true || result["auth_index"] != index) {
+				t.Fatalf("invalid success receipt %v", result)
+			}
+		})
+	}
+}
+func TestStopAndCancelRejectsUnknownAndEmpty(t *testing.T) {
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: t.TempDir()}, coreauth.NewManager(nil, nil, nil))
+	for _, tc := range []struct {
+		body   string
+		status int
+	}{{`{}`, 400}, {`{"auth_index":"missing"}`, 404}, {`invalid`, 400}} {
+		rec := httptest.NewRecorder()
+		ctx, _ := gin.CreateTestContext(rec)
+		ctx.Request = httptest.NewRequest(http.MethodPost, "/v8/management/routing/stop-and-cancel", strings.NewReader(tc.body))
+		h.StopAndCancel(ctx)
+		if rec.Code != tc.status || !strings.Contains(rec.Body.String(), `"drained":false`) {
+			t.Fatalf("status=%d body=%s", rec.Code, rec.Body)
+		}
+	}
+}
